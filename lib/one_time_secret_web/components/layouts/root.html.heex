<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="OneTimeSecret" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          document.documentElement.setAttribute("data-theme", theme);
          localStorage.setItem("ots:theme", theme);
        };

        // Load saved theme or default to light
        const savedTheme = localStorage.getItem("ots:theme") || "light";
        setTheme(savedTheme);

        // Listen for theme change events from LiveView
        window.addEventListener("phx:set-theme", ({ detail: { theme } }) => {
          setTheme(theme);
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
